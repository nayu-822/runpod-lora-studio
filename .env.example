# Application metadata
RUNPOD_LORA_STUDIO_APP_TITLE=RunPod LoRA Studio
RUNPOD_LORA_STUDIO_APP_ENV=development
RUNPOD_LORA_STUDIO_APP_VERSION=0.1.0

# Gradio
RUNPOD_LORA_STUDIO_GRADIO_SERVER_NAME=0.0.0.0
RUNPOD_LORA_STUDIO_GRADIO_SERVER_PORT=7860
RUNPOD_LORA_STUDIO_GRADIO_SHARE=false

# Logging
RUNPOD_LORA_STUDIO_LOG_LEVEL=INFO

# Runtime paths inside the RunPod workspace
RUNPOD_LORA_STUDIO_WORKSPACE_ROOT=/workspace/ldts-runtime
RUNPOD_LORA_STUDIO_PROJECTS_DIR=/workspace/ldts-runtime/projects
RUNPOD_LORA_STUDIO_MODELS_DIR=/workspace/ldts-runtime/models
RUNPOD_LORA_STUDIO_OUTPUTS_DIR=/workspace/ldts-runtime/outputs
RUNPOD_LORA_STUDIO_LOGS_DIR=/workspace/ldts-runtime/logs
RUNPOD_LORA_STUDIO_TEMP_DIR=/workspace/ldts-runtime/tmp
RUNPOD_LORA_STUDIO_DATABASE_PATH=/workspace/ldts-runtime/database/ldts.sqlite3
RUNPOD_LORA_STUDIO_MAX_UPLOAD_FILES=100
RUNPOD_LORA_STUDIO_MAX_UPLOAD_FILE_SIZE_BYTES=52428800
RUNPOD_LORA_STUDIO_MAX_IMAGE_PIXELS=100000000
RUNPOD_LORA_STUDIO_THUMBNAIL_SIZE=320

# Phase 2A image inspection (warnings only; source images are never deleted)
RUNPOD_LORA_STUDIO_INSPECTION_MIN_WIDTH=512
RUNPOD_LORA_STUDIO_INSPECTION_MIN_HEIGHT=512
RUNPOD_LORA_STUDIO_INSPECTION_MAX_ASPECT_RATIO=3.0
RUNPOD_LORA_STUDIO_INSPECTION_LOW_INFORMATION_STDDEV_THRESHOLD=8.0
RUNPOD_LORA_STUDIO_INSPECTION_BLUR_SCORE_THRESHOLD=50.0

# Phase 2B perceptual duplicate detection (candidates only; no auto-delete)
RUNPOD_LORA_STUDIO_PHASH_HASH_SIZE=8
RUNPOD_LORA_STUDIO_PHASH_DISTANCE_THRESHOLD=8
RUNPOD_LORA_STUDIO_PHASH_BATCH_SIZE=100
RUNPOD_LORA_STUDIO_SIMILARITY_GROUP_PAGE_SIZE=20

# Phase 3 automatic tagging and caption editing
RUNPOD_LORA_STUDIO_TAGGER_ADAPTER_NAME=wd14
RUNPOD_LORA_STUDIO_TAGGER_MODEL_IDENTIFIER=SmilingWolf/wd-eva02-large-tagger-v3
RUNPOD_LORA_STUDIO_TAGGER_MODEL_REVISION=main
RUNPOD_LORA_STUDIO_TAGGER_MODEL_DIR=/workspace/ldts-runtime/models/taggers/wd14
RUNPOD_LORA_STUDIO_TAGGER_DEVICE=auto
RUNPOD_LORA_STUDIO_TAGGER_BATCH_SIZE=4
RUNPOD_LORA_STUDIO_TAGGER_GENERAL_THRESHOLD=0.35
RUNPOD_LORA_STUDIO_TAGGER_CHARACTER_THRESHOLD=0.85
RUNPOD_LORA_STUDIO_TAGGER_SAVE_RATING=false
RUNPOD_LORA_STUDIO_TAGGER_SAVE_CHARACTER=true
RUNPOD_LORA_STUDIO_TAGGER_SAVE_GENERAL=true
RUNPOD_LORA_STUDIO_TAGGER_UNDERSCORE_TO_SPACE=false
RUNPOD_LORA_STUDIO_TAGGER_ESCAPE_MODE=none
RUNPOD_LORA_STUDIO_TAGGER_MAX_WORKERS=1
RUNPOD_LORA_STUDIO_TAGGER_ALLOW_MODEL_DOWNLOAD=false
RUNPOD_LORA_STUDIO_TAGGER_CAPTION_PAGE_SIZE=20

# Phase 4 dataset snapshots
RUNPOD_LORA_STUDIO_DATASET_SNAPSHOT_PAGE_SIZE=20
RUNPOD_LORA_STUDIO_DATASET_SNAPSHOT_COPY_BATCH_SIZE=20
RUNPOD_LORA_STUDIO_DATASET_SNAPSHOT_GENERATOR_VERSION=phase4-snapshot-v1
RUNPOD_LORA_STUDIO_DATASET_DEFAULT_RESOLUTION=1024
RUNPOD_LORA_STUDIO_DATASET_DEFAULT_MIN_BUCKET_RESO=256
RUNPOD_LORA_STUDIO_DATASET_DEFAULT_MAX_BUCKET_RESO=2048
RUNPOD_LORA_STUDIO_DATASET_DEFAULT_BUCKET_RESO_STEPS=64
RUNPOD_LORA_STUDIO_DATASET_DEFAULT_NUM_REPEATS=1
RUNPOD_LORA_STUDIO_DATASET_ALLOW_EMPTY_CAPTION=false
RUNPOD_LORA_STUDIO_DATASET_DISK_SAFETY_MARGIN_BYTES=268435456
RUNPOD_LORA_STUDIO_DATASET_DISK_WARNING_MARGIN_BYTES=1073741824

# Phase 5 Google Drive / rclone storage
RUNPOD_LORA_STUDIO_RCLONE_EXECUTABLE=rclone
RUNPOD_LORA_STUDIO_RCLONE_CONFIG_PATH=/workspace/ldts-runtime/config/rclone.conf
RUNPOD_LORA_STUDIO_STORAGE_REMOTE_NAME=gdrive
RUNPOD_LORA_STUDIO_STORAGE_MODEL_REMOTE_ROOT=lora-studio/models
RUNPOD_LORA_STUDIO_STORAGE_PROJECT_REMOTE_ROOT=lora-studio/projects
RUNPOD_LORA_STUDIO_STORAGE_SNAPSHOT_REMOTE_ROOT=snapshots
RUNPOD_LORA_STUDIO_STORAGE_ARTIFACT_REMOTE_ROOT=artifacts
RUNPOD_LORA_STUDIO_MODEL_CACHE_DIR=/workspace/ldts-runtime/models/base
RUNPOD_LORA_STUDIO_TRANSFER_TEMP_DIR=/workspace/ldts-runtime/tmp/transfers
RUNPOD_LORA_STUDIO_RCLONE_TRANSFERS=4
RUNPOD_LORA_STUDIO_RCLONE_CHECKERS=8
RUNPOD_LORA_STUDIO_RCLONE_RETRIES=3
RUNPOD_LORA_STUDIO_RCLONE_LOW_LEVEL_RETRIES=10
RUNPOD_LORA_STUDIO_RCLONE_RETRY_INTERVAL_SECONDS=5
RUNPOD_LORA_STUDIO_RCLONE_CONNECT_TIMEOUT_SECONDS=30
RUNPOD_LORA_STUDIO_RCLONE_TRANSFER_TIMEOUT_SECONDS=3600
RUNPOD_LORA_STUDIO_RCLONE_BANDWIDTH_LIMIT=
RUNPOD_LORA_STUDIO_RCLONE_BUFFER_SIZE=16M
RUNPOD_LORA_STUDIO_STORAGE_USE_CHECKSUM=true
RUNPOD_LORA_STUDIO_STORAGE_REMOTE_HASH_FALLBACK=error
RUNPOD_LORA_STUDIO_STORAGE_DRY_RUN_DEFAULT=true
RUNPOD_LORA_STUDIO_STORAGE_OVERWRITE_POLICY=skip_identical
RUNPOD_LORA_STUDIO_STORAGE_VERIFICATION_POLICY=remote_hash_and_size
RUNPOD_LORA_STUDIO_MODEL_ALLOW_CKPT=false
RUNPOD_LORA_STUDIO_MODEL_MAX_FILE_SIZE_BYTES=32212254720
RUNPOD_LORA_STUDIO_MODEL_DISK_SAFETY_MARGIN_BYTES=268435456
RUNPOD_LORA_STUDIO_TRANSFER_PROGRESS_INTERVAL_SECONDS=2
RUNPOD_LORA_STUDIO_TRAINING_MEMORY_MEASUREMENT_INTERVAL_SECONDS=5
RUNPOD_LORA_STUDIO_TRAINING_MEMORY_MAX_SAMPLES=20000
# Optional platform setting; the job snapshot records its normalized mapping.
# CUDA_VISIBLE_DEVICES=0
RUNPOD_LORA_STUDIO_STORAGE_RETRY_MAX_BACKOFF_SECONDS=300
RUNPOD_LORA_STUDIO_STORAGE_JOB_STALE_AFTER_SECONDS=120

# Phase 8A Danbooru metadata search (image bytes are not downloaded)
RUNPOD_LORA_STUDIO_IMAGE_SEARCH_CONNECT_TIMEOUT_SECONDS=10
RUNPOD_LORA_STUDIO_IMAGE_SEARCH_READ_TIMEOUT_SECONDS=30
RUNPOD_LORA_STUDIO_IMAGE_SEARCH_MAX_RESPONSE_BYTES=4194304
RUNPOD_LORA_STUDIO_IMAGE_SEARCH_MIN_INTERVAL_SECONDS=1
RUNPOD_LORA_STUDIO_IMAGE_SEARCH_RETRY_MAX_ATTEMPTS=4
RUNPOD_LORA_STUDIO_IMAGE_SEARCH_RETRY_BASE_BACKOFF_SECONDS=1
RUNPOD_LORA_STUDIO_IMAGE_SEARCH_RETRY_MAX_BACKOFF_SECONDS=30
RUNPOD_LORA_STUDIO_IMAGE_SEARCH_MAX_PAGES=100
RUNPOD_LORA_STUDIO_IMAGE_SEARCH_MAX_REQUESTS=200
RUNPOD_LORA_STUDIO_IMAGE_SEARCH_STALE_AFTER_SECONDS=300

# Phase 8B verified image download and import
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_READ_TIMEOUT_SECONDS=60
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_MAX_HEADER_BYTES=65536
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_MAX_REDIRECTS=3
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_CHUNK_SIZE=262144
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_MAX_FILE_SIZE_BYTES=52428800
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_UNKNOWN_SIZE_LIMIT_BYTES=52428800
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_RETRY_MAX_ATTEMPTS=4
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_RETRY_BASE_BACKOFF_SECONDS=1
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_RETRY_MAX_BACKOFF_SECONDS=30
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_HEARTBEAT_INTERVAL_SECONDS=2
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_STALE_AFTER_SECONDS=300
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_DISK_SAFETY_MARGIN_BYTES=268435456
RUNPOD_LORA_STUDIO_IMAGE_DOWNLOAD_GENERATOR_VERSION=phase8b-worker-v1
# Optional Danbooru API credentials; never store these in SQLite or logs.
DANBOORU_LOGIN=
DANBOORU_API_KEY=

# Platform-provided environment variables
RUNPOD_POD_ID=
RUNPOD_API_KEY=
